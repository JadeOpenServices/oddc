  "sources": {
    "detachSignal": {
      "observedAt": "2026-10-10",
      "reason": "Detaching the keyboard removes 1fc9:0088 from USB and attaching adds it back (libinput, kernel log). The embedded controller raises no event for it: with ACPI EC debugging on, a charger unplug raised Query(0x09), a detach raised none. So presence on the bus is the only tablet mode signal.",
      "type": "validation"
    },
    "intelHid5ButtonArray": {
      "observedAt": "2026-10-10",
      "reason": "Volume buttons send nothing: intel-hid enables the 5-button array only for machines in its button_array_table, which lacks this model. With the parameter, the Intel HID 5 button array device sends KEY_VOLUMEUP and KEY_VOLUMEDOWN (tested on kernel 7.2.2).",
      "reference": "drivers/platform/x86/intel/hid.c button_array_table",
      "removeWhen": "the kernel in use lists the HP ZBook x2 G4 in button_array_table",
      "type": "validation"
    },
    "kickstandSwitch": {
      "observedAt": "2026-10-10",
      "reason": "Guided test on the machine: Intel Virtual Switches (INT33D6) sets SW_TABLET_MODE to 0 when the stand opens and 1 when it closes, with the keyboard attached in front. Folding the keyboard behind (only possible with the stand closed) and detaching it change nothing there. The switch flips at one stand angle; opening further changes nothing. A guided test of the combined switch (stand, detach, reattach in both stand positions) gave tablet mode exactly when the stand was closed or the keyboard gone.",
      "type": "validation"
    },
    "tabletModeSwitch": {
      "observedAt": "2026-10-10",
      "reason": "No switch reports tablet mode on its own: Intel Virtual Switches follows the kickstand (kickstandSwitch), HP WMI hotkeys never changes, and detaching the keyboard raises no event at all (kernel 7.2.2). Tablet mode is the stand closed or the keyboard gone.",
      "type": "validation"
    }
  }
}
