{
  "$schema": "../../../schemas/catalog.schema.json",
  "blocks": {},
  "extends": [
    "class/laptop"
  ],
  "facts": {
    "identity": {
      "dmi": {
        "systemVendor": "Framework"
      }
    },
    "secureBootFirmware": {
      "enrollmentBackend": "sbctl",
      "factoryOwnershipProof": "pk-equals-pkdefault",
      "firmwareName": "Framework UEFI",
      "instructions": [
        "Enter the firmware Secure Boot settings.",
        "Remove ONLY the active Platform Key (PK) to enter UEFI Setup Mode; preserve KEK, db, and dbx.",
        "Keep KEK, db, and dbx intact.",
        "Do not use an erase-all or reset-all Secure Boot keys action."
      ],
      "preserveFirmwareBuiltin": [
        "KEK",
        "db"
      ],
      "requiredAbsent": [
        "PK"
      ],
      "requiredPresent": [
        "KEK",
        "db",
        "dbx"
      ],
      "setupModeStrategy": "clear-platform-key",
      "supported": true,
      "untouched": [
        "dbx"
      ]
    }
  },
  "id": "vendor/framework",
  "kind": "vendor",
  "schemaVersion": "2.0.0"
}
