{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openjade.de/oddc/schemas/catalog.schema.json",
  "title": "ODDC catalog document",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "kind"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "2.0.0"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "kind": {
      "enum": [
        "class",
        "vendor",
        "family",
        "device"
      ]
    },
    "extends": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      },
      "uniqueItems": true
    },
    "facts": {
      "type": "object"
    },
    "blocks": {
      "$ref": "#/$defs/overrideObject"
    },
    "sources": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/key"
      },
      "additionalProperties": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[/-][a-z0-9]+)*$"
    },
    "key": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "scalar": {
      "type": [
        "string",
        "number",
        "integer",
        "boolean",
        "null"
      ]
    },
    "overrideNode": {
      "oneOf": [
        {
          "$ref": "#/$defs/scalar"
        },
        {
          "$ref": "#/$defs/overrideObject"
        }
      ]
    },
    "overrideObject": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/key"
      },
      "additionalProperties": {
        "$ref": "#/$defs/overrideNode"
      }
    },
    "source": {
      "type": "object",
      "required": [
        "type",
        "reference"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "observedAt": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
