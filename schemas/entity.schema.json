{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openjade.de/oddc/schemas/entity.schema.json",
  "title": "ODDC canonical entity",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "data"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "apiVersion": {
      "const": "oddc.openjade.de/v2"
    },
    "kind": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]*$"
    },
    "metadata": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[/-][a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "data": {
      "$ref": "#/$defs/object"
    },
    "sources": {
      "$ref": "#/$defs/object"
    }
  },
  "$defs": {
    "scalar": {
      "type": [
        "string",
        "number",
        "integer",
        "boolean",
        "null"
      ]
    },
    "node": {
      "oneOf": [
        {
          "$ref": "#/$defs/scalar"
        },
        {
          "$ref": "#/$defs/object"
        }
      ]
    },
    "object": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/node"
      }
    }
  },
  "additionalProperties": false
}
