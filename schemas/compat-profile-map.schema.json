{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openjade.de/oddc/schemas/compat-profile-map.schema.json",
  "title": "GjallarOS ODDC profile compatibility map",
  "type": "object",
  "required": [
    "schemaVersion",
    "profiles"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "2.0.0"
    },
    "profiles": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^laptop/[a-z0-9-]+/[a-z0-9-]+$"
      }
    }
  },
  "additionalProperties": false
}
