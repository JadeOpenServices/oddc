{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openjade.de/oddc/schemas/overlay.schema.json",
  "title": "ODDC override",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "kind",
    "targetDevice",
    "blocks"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "2.0.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[/-][a-z0-9]+)*$"
    },
    "kind": {
      "enum": [
        "project",
        "host"
      ]
    },
    "targetDevice": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "blocks": {
      "$ref": "#/$defs/overrideObject"
    }
  },
  "$defs": {
    "key": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "scalar": {
      "type": [
        "string",
        "number",
        "integer",
        "boolean",
        "null"
      ]
    },
    "overrideNode": {
      "oneOf": [
        {
          "$ref": "#/$defs/scalar"
        },
        {
          "$ref": "#/$defs/overrideObject"
        }
      ]
    },
    "overrideObject": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/key"
      },
      "additionalProperties": {
        "$ref": "#/$defs/overrideNode"
      }
    }
  },
  "additionalProperties": false
}
